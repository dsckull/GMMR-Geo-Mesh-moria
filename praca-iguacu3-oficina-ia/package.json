    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "engines": {
    "node": ">=20"
  }
