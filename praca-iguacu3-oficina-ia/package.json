  "private": true,
  "type": "module",
  "description": "Editor espacial humano-IA CPU-first para a Praca Iguacu 3",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
